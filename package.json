{
  "name": "critica",
  "version": "0.1.0",
  "description": "Constructive solid geometry (CSG) in WebAssembly",
  "type": "module",
  "license": "MIT",
  "main": "./pkg/critica.js",
  "types": "./pkg/critica.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/critica.d.ts",
      "default": "./pkg/critica.js"
    }
  },
  "files": [
    "pkg/"
  ],
  "scripts": {
    "build": "cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/critica.wasm pkg/",
    "test": "cargo test --release && npm run build && node --test js-tests/*.test.mjs",
    "demo": "npm run build && node app/serve.mjs",
    "gen:data": "python3 tools/gen_nuclear_data.py"
  }
}
